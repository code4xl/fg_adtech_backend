FROM node:23

# Enable and prepare pnpm
RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /usr/src/app

# Install NestJS CLI globally
RUN npm install -g @nestjs/cli

# Create upload directories
RUN mkdir -p uploads/audience-csv

# Copy package files
COPY package.json pnpm-lock.yaml* ./

# Install dependencies
RUN pnpm install

# Copy tsconfig.json and nest-cli.json first
COPY tsconfig.json nest-cli.json ./

# Copy other necessary files
COPY prisma ./prisma/
COPY scripts ./scripts/

# Generate Prisma client
RUN npx prisma generate

# Copy source code
COPY src ./src/

# Build the application
RUN pnpm run build

# Ensure the templates directory exists and copy mail templates directly
RUN mkdir -p dist/src/mail/templates
COPY src/mail/templates/*.hbs dist/src/mail/templates/

# Command to run the application
CMD ["pnpm", "run", "start:dev"]