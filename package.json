{
  "name": "programmatic_adtech_backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "setup:dotenv:dev": "dotenv -e .env.development",
    "setup:dotenv:prod": "dotenv -e .env.production",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "watch": "start nest start --watch",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test:openai": "ts-node -r tsconfig-paths/register scripts/test-openai-models.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "prisma:dev:migrate": "dotenv -e .env.development -- prisma migrate dev",
    "prisma:dev:generate": "dotenv -e .env.development -- prisma generate",
    "prisma:prod:migrate": "dotenv -e .env.production -- prisma migrate dev",
    "prisma:prod:generate": "dotenv -e .env.production -- prisma generate",
    "prisma:reset": "dotenv -e .env.development -- prisma migrate reset",
    "prisma:studio": "dotenv -e .env.development -- prisma studio",
    "seed": "dotenv -e .env.development -- ts-node -r tsconfig-paths/register src/cli.ts db:seed",
    "seed:clean": "dotenv -e .env.development -- ts-node -r tsconfig-paths/register src/cli.ts db:seed --clean",
    "seed:module": "dotenv -e .env.development -- ts-node -r tsconfig-paths/register src/cli.ts db:seed:module",
    "seed:info": "dotenv -e .env.development -- ts-node -r tsconfig-paths/register src/cli.ts db:seed:info",
    "db:clean": "dotenv -e .env.development -- ts-node -r tsconfig-paths/register src/cli.ts db:clean",
    "docker:up:dev": "docker compose -f docker-compose.dev.yml up -d",
    "docker:build:dev": "docker compose -f docker-compose.dev.yml up --build -d",
    "docker-logs:api:dev": "docker compose -f docker-compose.dev.yml logs api -f",
    "docker-logs:kafka:dev": "docker compose -f docker-compose.dev.yml logs kafka -f",
    "docker-logs:redis:dev": "docker compose -f docker-compose.dev.yml logs redis -f",
    "docker:down:dev": "docker compose -f docker-compose.dev.yml down",
    "docker:down:dev:v": "docker compose -f docker-compose.dev.yml down -v"
  },
