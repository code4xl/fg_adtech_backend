// From targetingRule.prisma
// DEMOGRAPHIC TARGETING
model DemographicTargeting {
  id          String  @id @default(uuid()) @db.Uuid
  campaignId  String? @db.Uuid
  inventoryId String? @db.Uuid

  // Demographic fields with proper enums
  ageMin      Int?
  ageMax      Int?
  genders     Gender[]
  languages   Language[]
  education   Education[]
  incomeRange IncomeRange[] // Using enum instead of min/max integers

  // Relationship
  campaign  Campaign?    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  inventory AdInventory? @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId])
  @@index([inventoryId])
  @@index([ageMin, ageMax])
}

// GEOGRAPHIC TARGETING
model GeographicTargeting {
  id          String  @id @default(uuid()) @db.Uuid
  campaignId  String? @db.Uuid
  inventoryId String? @db.Uuid

  // Geographic fields with proper enums
  countries   String[] // Using ISO 3166-1 alpha-2 codes for countries
  states      String[] // For Indian states, could be extended for other countries
  cities      String[] // Keep as string since city names vary widely
  postalCodes String[]
  radius      Int? // Radius in KM for location targeting
  latitude    Float?
  longitude   Float?

  // Include/Exclude logic
  isInclude Boolean @default(true) // true = include, false = exclude

  // Relationships
  campaign  Campaign?    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  inventory AdInventory? @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId])
  @@index([inventoryId])
  @@index([countries])
}

// DEVICE TARGETING
model DeviceTargeting {
  id          String  @id @default(uuid()) @db.Uuid
  campaignId  String? @db.Uuid
  inventoryId String? @db.Uuid

  // Device fields with proper enums
  deviceTypes      DeviceType[]
  operatingSystems OperatingSystem[]
  browsers         BrowserType[]
  connectionTypes  ConnectionType[]

  // Mobile specific
  minOSVersion String?
  maxOSVersion String?
  deviceModels String[] // Keep as string since device models vary widely

  // Include/Exclude logic
  isInclude Boolean @default(true)

  // Relationships
  campaign  Campaign?    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  inventory AdInventory? @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId])
  @@index([inventoryId])
  @@index([deviceTypes])
}

// CONTEXTUAL TARGETING
model ContextualTargeting {
  id          String  @id @default(uuid()) @db.Uuid
  campaignId  String? @db.Uuid
  inventoryId String? @db.Uuid

  // Context fields with proper enums
  contentCategories BusinessCategory[]
  keywords          String[] // Keywords to match in page content
  urlPatterns       String[] // URL patterns to match
  pageTypes         PageType[]
  brandSafety       BrandSafety[]

  // Content safety
  blockedKeywords String[] // Keywords to avoid

  // Include/Exclude logic
  isInclude Boolean @default(true)

  // Relationships
  campaign  Campaign?    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  inventory AdInventory? @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId])
  @@index([inventoryId])
  @@index([contentCategories])
}

// BEHAVIORAL TARGETING
model BehavioralTargeting {
  id          String  @id @default(uuid()) @db.Uuid
  campaignId  String? @db.Uuid
  inventoryId String? @db.Uuid

  // Behavioral fields with proper enums
  interests         CampaignInterest[]
  purchaseIntent    PurchaseIntent[]
  lifestyleSegments LifestyleSegment[]
  audienceTypes     AudienceType[]
  userSegments      UserSegment[]

  // Shopping behavior with enums
  purchaseFrequency PurchaseFrequency[]
  sessionEngagement SessionEngagement[]

  // Numeric thresholds
  avgOrderValue   Decimal? @db.Decimal(10, 2)
  sessionDuration Int? // Minutes
  pageViews       Int? // Average page views per session

  // Include/Exclude logic
  isInclude Boolean @default(true)

  // Relationships
  campaign  Campaign?    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  inventory AdInventory? @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId])
  @@index([inventoryId])
  @@index([interests])
}

// TIME TARGETING
model TimeTargeting {
  id          String  @id @default(uuid()) @db.Uuid
  campaignId  String? @db.Uuid
  inventoryId String? @db.Uuid

  // Time fields with proper enums
  timezone     String        @default("Asia/Kolkata")
  timeSlots    TimeSlot[] // Predefined time slots
  daysOfWeek   DayOfWeek[] // Using enum instead of integers
  holidayTypes HolidayType[]

  // Fine-grained control (optional)
  startHour Int? // 0-23
  endHour   Int? // 0-23
  startDate DateTime?
  endDate   DateTime?

  // Special time periods
  includeHolidays Boolean @default(true)
  workingDaysOnly Boolean @default(false)

  // Relationships
  campaign  Campaign?    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  inventory AdInventory? @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId])
  @@index([inventoryId])
  @@index([startHour, endHour])
}

// FREQUENCY TARGETING
model FrequencyTargeting {
  id          String  @id @default(uuid()) @db.Uuid
  campaignId  String? @db.Uuid
  inventoryId String? @db.Uuid

  // Frequency fields with proper enums
  maxImpressions  Int
  frequencyWindow FrequencyWindow // Using enum instead of hours
  frequencyScope  FrequencyScope // Using enum for scope

  // Advanced frequency
  maxClicksPerUser Int?
  minTimeBetween   Int? // Minimum minutes between impressions

  // Custom time window (if needed beyond enum)
  customTimeWindowHours Int? // For flexibility

  // Relationships
  campaign  Campaign?    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  inventory AdInventory? @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId])
  @@index([inventoryId])
}

// From tracking-timestream.prisma
// Models for Timestream sync metadata
model TimestreamSyncLog {
    id           String   @id @default(uuid()) @db.Uuid
    tableName    String // impressions, clicks, bids
    lastSyncTime DateTime
    recordCount  Int
    status       String // SUCCESS, FAILED, PARTIAL
    errorMessage String?
    createdAt    DateTime @default(now())

    @@index([tableName, lastSyncTime])
}

// Enhanced tracking for PostgreSQL (before Timestream sync)
model ImpressionEvent {
    id String @id @default(uuid()) @db.Uuid

    // PRIMARY: Creative that was displayed
    creativeId    String @db.Uuid
    bidResponseId String @db.Uuid

    // HIERARCHY: All related entities for multi-dimensional analytics
    campaignId   String  @db.Uuid
    advertiserId String  @db.Uuid
    inventoryId  String  @db.Uuid
    publisherId  String  @db.Uuid
    websiteId    String  @db.Uuid
    adSlotId     String? @db.Uuid // Specific slot on the website

    // FINANCIAL: Revenue/cost tracking
    price            Decimal? @db.Decimal(10, 4) // What advertiser paid
    publisherRevenue Decimal? @db.Decimal(10, 4) // What publisher earned

    // USER CONTEXT: For attribution and analytics
    userId    String? // If available (cookie/device ID)
    sessionId String? // User session identifier

    // TECHNICAL DETAILS
    timestamp   DateTime @default(now())
    userAgent   String?
    ipAddress   String?
    deviceType  String?
    browserType String?
    osType      String?

    // GEO CONTEXT
    country String?
    region  String?
    city    String?

    // VIEWABILITY METRICS (IAB standards)
    viewable       Boolean? // Was it viewable per IAB standards
    viewTime       Int? // Milliseconds in view
    viewablePixels Int? // Pixels visible
    adSizePixels   String? // "300x250"

    // FRAUD DETECTION
    isBot      Boolean? @default(false)
    fraudScore Float? // 0.0 to 1.0

    // ATTRIBUTION
    referrerUrl  String?
    pageUrl      String?
    pageCategory String?

    // SYNC STATUS
    syncedToTimestream Boolean   @default(false)
    syncedAt           DateTime?

    // RELATIONS
    creative   Creative     @relation(fields: [creativeId], references: [id])
    campaign   Campaign     @relation(fields: [campaignId], references: [id])
    inventory  AdInventory  @relation(fields: [inventoryId], references: [id])
    publisher  Publisher    @relation(fields: [publisherId], references: [id])
    ClickEvent ClickEvent[]

    @@index([creativeId, timestamp]) // Primary: Creative performance
    @@index([campaignId, timestamp]) // Campaign analytics
    @@index([inventoryId, timestamp]) // Inventory performance
    @@index([publisherId, timestamp]) // Publisher earnings
    @@index([timestamp]) // Time-based queries
    @@index([syncedToTimestream]) // Sync management
    @@index([userId, campaignId]) // Frequency capping
}

model ClickEvent {
    id String @id @default(uuid()) @db.Uuid

    // LINK TO IMPRESSION
    impressionId String? @db.Uuid // Link back to impression if available

    // PRIMARY: Creative that was clicked
    creativeId    String @db.Uuid
    bidResponseId String @db.Uuid

    // HIERARCHY: All related entities
    campaignId   String  @db.Uuid
    advertiserId String  @db.Uuid
    inventoryId  String  @db.Uuid
    publisherId  String  @db.Uuid
    websiteId    String  @db.Uuid
    adSlotId     String? @db.Uuid

    // USER CONTEXT
    userId    String?
    sessionId String?

    // TECHNICAL DETAILS
    timestamp   DateTime @default(now())
    userAgent   String?
    ipAddress   String?
    deviceType  String?
    browserType String?
    osType      String?

    // GEO CONTEXT
    country String?
    region  String?
    city    String?

    // CLICK DETAILS
    clickX    Int? // X coordinate of click
    clickY    Int? // Y coordinate of click
    clickArea String? // Which part of ad was clicked

    // LANDING PAGE
    landingUrl    String? // Where user was redirected
    landingLoaded Boolean? // Did landing page load successfully

    // FRAUD DETECTION
    isBot        Boolean? @default(false)
    fraudScore   Float?
    clickPattern String? // rapid_fire, normal, suspicious

    // ATTRIBUTION
    referrerUrl        String?
    pageUrl            String?
    timeFromImpression Int? // Milliseconds from impression to click

    // SYNC STATUS
    syncedToTimestream Boolean   @default(false)
    syncedAt           DateTime?

    // RELATIONS
    impression ImpressionEvent? @relation(fields: [impressionId], references: [id])
    creative   Creative         @relation(fields: [creativeId], references: [id])
    campaign   Campaign         @relation(fields: [campaignId], references: [id])
    inventory  AdInventory      @relation(fields: [inventoryId], references: [id])
    publisher  Publisher        @relation(fields: [publisherId], references: [id])

    @@index([creativeId, timestamp]) // Primary: Creative performance
    @@index([campaignId, timestamp]) // Campaign analytics
    @@index([inventoryId, timestamp]) // Inventory performance
    @@index([publisherId, timestamp]) // Publisher earnings
    @@index([impressionId]) // Link to impression
    @@index([timestamp]) // Time-based queries
    @@index([syncedToTimestream]) // Sync management
    @@index([userId, campaignId]) // User behavior analysis
}

// From website.prisma
model Website {
  id          String        @id @default(uuid()) @db.Uuid
  publisherId String        @db.Uuid
  domain      String?       @unique
  url         String?       @unique
  name        String
  description String?
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  initScript  String?
  cdnURL      String?
  // Relations
  publisher   Publisher     @relation(fields: [publisherId], references: [id], onDelete: Cascade)
  inventories AdInventory[]

  websiteCategories ContentCategory[]

  bidRequests BidRequest[]

  @@index([publisherId, url], name: "idx_website_publisher_url")
}
