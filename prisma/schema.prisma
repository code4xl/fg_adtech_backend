model AdInventory {
  id                   String                 @id @default(uuid()) @db.Uuid
  publisherId          String                 @db.Uuid
  name                 String
  isActive             Boolean                @default(true)
  adSlotTemplateId     String                 @db.Uuid
  adSlotTemplate       AdSlotTemplate         @relation(fields: [adSlotTemplateId], references: [id])
  viewabilityScore     Float?
  approvalStatus       ApprovalStatus         @default(PENDING)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  websiteId            String                 @db.Uuid
  adSlotScript         String?
  containerHTML        String?
  publisher            Publisher              @relation(fields: [publisherId], references: [id])
  floorPrices          FloorPrice[]
  bidRequests          BidRequest[]
  demographicTargeting DemographicTargeting[]
  geographicTargeting  GeographicTargeting[]
  deviceTargeting      DeviceTargeting[]
  contextualTargeting  ContextualTargeting[]
  behavioralTargeting  BehavioralTargeting[]
  timeTargeting        TimeTargeting[]
  frequencyTargeting   FrequencyTargeting[]
  hourlyMetrics        HourlyMetrics[]
  website              Website                @relation(fields: [websiteId], references: [id])

  ImpressionEvent ImpressionEvent[]

  ClickEvent ClickEvent[]
}

// From notification.prisma
model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  userType  UserType
  title     String
  message   String
  isRead    Boolean  @default(false)
  data      Json? // Additional structured data
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, userType])
  @@index([isRead])
}

// From payment.prisma
// Payment models for both advertisers and publishers

model PaymentMethod {
  id         String      @id @default(uuid()) @db.Uuid
  userId     String      @db.Uuid
  userType   UserType // ADVERTISER, PUBLISHER
  type       PaymentType
  isDefault  Boolean     @default(false)
  isVerified Boolean     @default(false)

  // Card details (encrypted)
  cardLast4  String?
  cardBrand  String?
  cardExpiry String?

  // Bank details
  bankName     String?
  accountLast4 String?
  ifscCode     String?

  // UPI details
  upiId String?

  // Razorpay/payment gateway IDs
  gatewayCustomerId String?
  gatewayMethodId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  transactions Transaction[]
}

model Transaction {
  id              String            @id @default(uuid()) @db.Uuid
  userId          String            @db.Uuid
  userType        UserType
  paymentMethodId String?           @db.Uuid
  type            TransactionType // CREDIT, DEBIT, REFUND
  amount          Decimal           @db.Decimal(10, 2)
  currency        String            @default("INR")
  status          TransactionStatus
  description     String?

  // Gateway details
  gatewayTransactionId String?
  gatewayOrderId       String?
  gatewayPaymentId     String?

  // Metadata
  campaignId         String?   @db.Uuid
  billingPeriodStart DateTime?
  billingPeriodEnd   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
}

model Wallet {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  userType  UserType
  balance   Decimal  @default(0) @db.Decimal(10, 2)
  currency  String   @default("INR")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// From publisher.prisma
model Publisher {
  id                   String          @id @default(uuid()) @db.Uuid
  firstName            String
  lastName             String
  email                String          @unique
  emailVerifiedAt      DateTime?
  password             String
  rememberToken        String?
  // domain               String?
  status               PublisherStatus @default(ACTIVE)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  // Added fields for authentication
  verificationToken    String?         @unique // For email verification
  resetPasswordToken   String?         @unique // For password reset
  resetPasswordExpires DateTime? // Password reset token expiration
  // MFA fields
  mfaEnabled           Boolean         @default(false)
  mfaVerificationCode  String?
  mfaCodeExpiry        DateTime?

  // Relations
  inventories AdInventory[]
  bidRequests BidRequest[]

  websites Website[]

  ImpressionEvent ImpressionEvent[]

  ClickEvent ClickEvent[]
}

// From rtb-cache.prisma
model RTBCache {
    id        String       @id @default(uuid()) @db.Uuid
    cacheKey  String       @unique
    cacheType RTBCacheType
    data      Json
    expiresAt DateTime
    createdAt DateTime     @default(now())

    @@index([cacheType, expiresAt])
}

// From rtb-enums.prisma
enum BidStatus {
  PENDING
  WON
  LOST
  TIMEOUT
  ERROR
  CANCELLED
}

enum AuctionStatus {
  PROCESSING
  COMPLETED
  NO_BIDS
  TIMEOUT
  ERROR
}

enum AuctionType {
  FIRST_PRICE
  SECOND_PRICE
}

enum RTBCacheType {
  ELIGIBLE_CAMPAIGNS
  CAMPAIGN_BUDGET
  TARGETING_RULES
  FLOOR_PRICES
}

// From rtb-metrics.prisma
model RTBMetrics {
    id             String   @id @default(uuid()) @db.Uuid
    timestamp      DateTime @default(now())
    bidRequestId   String?  @db.Uuid
    auctionLatency Int? // milliseconds
    bidCount       Int      @default(0)
    winRate        Float? // percentage
    fillRate       Float? // percentage
    avgBidPrice    Decimal? @db.Decimal(10, 4)

    @@index([timestamp])
}

