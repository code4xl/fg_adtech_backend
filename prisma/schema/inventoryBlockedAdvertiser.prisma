model InventoryBlockedAdvertiser {
  inventoryId       String              @db.Uuid
  advertiserId      String              @db.Uuid
  createdAt         DateTime           @default(now())

  // Relations
  inventory         AdInventory        @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  advertiser        Advertiser         @relation(fields: [advertiserId], references: [id], onDelete: Cascade)

  @@id([inventoryId, advertiserId])
}