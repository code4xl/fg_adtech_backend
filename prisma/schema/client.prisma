model Client {
  id                   String           @id @default(uuid()) @db.Uuid
  name                 String
  email                String           @unique
  mobile               String           @unique
  companyName          String
  hqLocation           String
  companySize          CompanySize
  registeredAddress    String
  companyGSTIN         String           @unique
  PAN                  String           @unique
  CIN                  String           @unique
  website              String
  password             String
  advertiserId         String           @db.Uuid
  emailVerifiedAt      DateTime?
  verificationToken    String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  status               ClientStatus     @default(ACTIVE)
  resetPasswordExpires DateTime?
  resetPasswordToken   String?          @unique
  Campaign             Campaign[]
  assignedCampaigns    ClientCampaign[]
  advertiser           Advertiser       @relation(fields: [advertiserId], references: [id], onDelete: Cascade)

  @@map("clients")
}

model ClientCampaign {
  id         String     @id @default(uuid()) @db.Uuid
  clientId   String     @db.Uuid
  campaignId String     @db.Uuid
  assignedAt DateTime   @default(now())
  assignedBy String     @db.Uuid
  advertiser Advertiser @relation(fields: [assignedBy], references: [id])
  campaign   Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  client     Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, campaignId])
  @@map("client_campaigns")
}
