model Client {
    id                String                @id @default(uuid()) @db.Uuid
    name              String
    email             String                @unique
    mobile            String
    companyName       String
    hqLocation        String
    companySize       AdvertiserCompanySize
    registeredAddress String
    companyGSTIN      String
    PAN               String
    CIN               String
    website           String
    createdAt         DateTime              @default(now())
    updatedAt         DateTime              @updatedAt
}
