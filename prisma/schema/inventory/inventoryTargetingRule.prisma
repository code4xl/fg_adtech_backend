model InventoryTargetingRule {
  id                String               @id @default(uuid()) @db.Uuid
  inventoryId       String               @db.Uuid
  ruleType          TargetingRuleType
  ruleData          Json
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  // Relations
  inventory         AdInventory        @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
}