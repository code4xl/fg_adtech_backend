model Notification {
    id        String   @id @default(uuid()) @db.Uuid
    userId    String   @db.Uuid
    userType  UserType
    title     String
    message   String
    isRead    Boolean  @default(false)
    data      Json? // Additional structured data
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([userId, userType])
    @@index([isRead])
}

enum UserType {
    ADVERTISER
    PUBLISHER
    CLIENT
    ADMIN
}
