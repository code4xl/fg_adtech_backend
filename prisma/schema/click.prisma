model Click {
  id           String   @id @default(uuid()) @db.Uuid
  impressionId String   @db.Uuid
  ipAddress    String?
  userAgent    String?
  deviceType   String?
  browserType  String?
  country      String?
  region       String?
  city         String?
  referrer     String?
  clickTime    DateTime @default(now())
  createdAt    DateTime @default(now())

  // Relations
  impression Impression @relation(fields: [impressionId], references: [id])
}
