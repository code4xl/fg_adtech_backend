model PublisherRevenue {
    id           String  @id @default(uuid()) @db.Uuid
    publisherId  String  @db.Uuid
    campaignId   String  @db.Uuid
    impressionId String? @db.Uuid
    clickId      String? @db.Uuid

    // Revenue details
    grossRevenue   Decimal @db.Decimal(10, 6) // e.g., 0.002500
    commissionRate Decimal @db.Decimal(3, 2) // e.g., 0.30 (30%) [DERIVED FROM PublisherTier ENUM in publisher model]
    netRevenue     Decimal @db.Decimal(10, 6) // e.g., 0.00175 [grossRevenue * (1 - commissionRate)]
    // eg of calc -> 0.002500 * (1 - 0.30) = 0.001750

    // Event details
    eventType   RevenueEventType
    inventoryId String           @db.Uuid
    createdAt   DateTime         @default(now())

    // Relations
    publisher Publisher @relation(fields: [publisherId], references: [id])

    @@index([publisherId, createdAt])
    @@index([campaignId, createdAt])
    @@index([createdAt, eventType])
}

model SystemRevenue {
    id           String  @id @default(uuid()) @db.Uuid
    campaignId   String  @db.Uuid
    publisherId  String  @db.Uuid
    impressionId String? @db.Uuid
    clickId      String? @db.Uuid

    // Revenue breakdown per event
    grossRevenue     Decimal @db.Decimal(10, 6) // Total from advertiser (e.g., 0.002500)
    publisherShare   Decimal @db.Decimal(10, 6) // Publisher gets (e.g., 0.001750)
    systemCommission Decimal @db.Decimal(10, 6) // Company keeps (e.g., 0.000750)
    commissionRate   Decimal @db.Decimal(3, 2) // Rate used (e.g., 0.30 = 30%) [DERIVED FROM PublisherTier ENUM in publisher model]

    // Event details
    eventType RevenueEventType // IMPRESSION, CLICK

    // Metadata
    inventoryId String   @db.Uuid
    createdAt   DateTime @default(now())

    // Relations
    campaign  Campaign    @relation(fields: [campaignId], references: [id])
    publisher Publisher   @relation(fields: [publisherId], references: [id])
    inventory AdInventory @relation(fields: [inventoryId], references: [id])
}

model SystemDailyRevenue {
    id   String   @id @default(uuid()) @db.Uuid
    date DateTime @db.Date

    // Volume metrics
    totalImpressions Int @default(0)
    totalClicks      Int @default(0)

    // Revenue breakdown
    totalGrossRevenue    Decimal @default(0) @db.Decimal(10, 2) // From advertisers [of all campaigns]
    totalPublisherPayout Decimal @default(0) @db.Decimal(10, 2) // To publishers
    totalSystemRevenue   Decimal @default(0) @db.Decimal(10, 2) // Company profit

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([date])
    @@index([date])
}

model BudgetTransaction {
    id          String          @id @default(uuid()) @db.Uuid
    campaignId  String          @db.Uuid
    type        TransactionType // IMPRESSION_COST, CLICK_COST, REFUND, ADJUSTMENT
    amount      Decimal         @db.Decimal(10, 6)
    description String?

    // Event linkage
    impressionId String? @db.Uuid
    clickId      String? @db.Uuid

    // Metadata
    publisherId String? @db.Uuid
    inventoryId String? @db.Uuid

    createdAt DateTime @default(now())

    // Relations
    campaign Campaign @relation(fields: [campaignId], references: [id])

    @@index([campaignId, createdAt])
    @@index([type, createdAt])
}
