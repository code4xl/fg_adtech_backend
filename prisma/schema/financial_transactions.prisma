model PublisherRevenue {
  id             String           @id @default(uuid()) @db.Uuid
  publisherId    String           @db.Uuid
  campaignId     String           @db.Uuid
  grossRevenue   Decimal          @db.Decimal(12, 4)
  commissionRate Decimal          @db.Decimal(5, 4)
  netRevenue     Decimal          @db.Decimal(12, 4)
  eventType      RevenueEventType
  inventoryId    String           @db.Uuid
  createdAt      DateTime         @default(now())
  websiteId      String           @db.Uuid
  campaign       Campaign         @relation(fields: [campaignId], references: [id])
  inventory      AdInventory      @relation(fields: [inventoryId], references: [id])
  publisher      Publisher        @relation(fields: [publisherId], references: [id])
  website        Website          @relation(fields: [websiteId], references: [id])

  @@index([publisherId, createdAt])
  @@index([campaignId, createdAt])
  @@index([createdAt, eventType])
  @@index([inventoryId, createdAt])
  @@index([websiteId, createdAt])
  @@index([eventType])
  @@index([publisherId, createdAt, eventType])
  @@index([campaignId, inventoryId, createdAt])
  @@index([inventoryId, eventType, createdAt])
  @@index([publisherId, campaignId, createdAt])
  @@index([websiteId, eventType, createdAt])
  @@index([campaignId, eventType, createdAt])
}

model AdvertiserSpending {
  id           String           @id @default(uuid()) @db.Uuid
  advertiserId String           @db.Uuid
  campaignId   String           @db.Uuid
  creativeId   String           @db.Uuid
  amount       Decimal          @db.Decimal(12, 4)
  eventType    RevenueEventType
  createdAt    DateTime         @default(now())
  campaign     Campaign         @relation(fields: [campaignId], references: [id])

  @@index([advertiserId, createdAt])
  @@index([campaignId, createdAt])
  @@index([eventType, createdAt])
  @@index([creativeId, createdAt])
  @@index([eventType])
  @@index([advertiserId, campaignId, createdAt])
  @@index([campaignId, creativeId, createdAt])
  @@index([advertiserId, eventType, createdAt])
  @@index([creativeId, eventType, createdAt])
}

model SystemRevenue {
  id             String           @id @default(uuid()) @db.Uuid
  campaignId     String           @db.Uuid
  publisherId    String           @db.Uuid
  grossRevenue   Decimal          @db.Decimal(12, 4)
  publisherShare Decimal          @db.Decimal(12, 4)
  commissionRate Decimal          @db.Decimal(5, 4)
  eventType      RevenueEventType
  inventoryId    String           @db.Uuid
  createdAt      DateTime         @default(now())
  advertiserId   String           @db.Uuid
  creativeId     String           @db.Uuid
  systemEarning  Decimal          @db.Decimal(12, 4)
  campaign       Campaign         @relation(fields: [campaignId], references: [id])
  inventory      AdInventory      @relation(fields: [inventoryId], references: [id])
  publisher      Publisher        @relation(fields: [publisherId], references: [id])

  @@index([campaignId, createdAt])
  @@index([publisherId, createdAt])
  @@index([inventoryId, createdAt])
  @@index([advertiserId, createdAt])
  @@index([creativeId, eventType, createdAt])
  @@index([commissionRate, createdAt])
  @@index([eventType, createdAt])
  @@index([publisherId, campaignId, createdAt])
  @@index([inventoryId, eventType, createdAt])
  @@index([advertiserId, publisherId, createdAt])
}

model PublisherDailyRevenue {
  id               String    @id @default(uuid()) @db.Uuid
  publisherId      String    @db.Uuid
  date             DateTime  @db.Date
  totalImpressions Int       @default(0)
  totalClicks      Int       @default(0)
  grossRevenue     Decimal   @default(0) @db.Decimal(15, 4)
  netRevenue       Decimal   @default(0) @db.Decimal(15, 4)
  commissionPaid   Decimal   @default(0) @db.Decimal(15, 4)
  lastUpdated      DateTime  @default(now()) @updatedAt
  publisher        Publisher @relation(fields: [publisherId], references: [id])

  @@unique([publisherId, date])
  @@index([publisherId, date])
  @@index([date])
  @@index([date, grossRevenue])
  @@index([date, totalImpressions])
  @@index([publisherId, grossRevenue])
}

model AdvertiserDailySpending {
  id               String     @id @default(uuid()) @db.Uuid
  advertiserId     String     @db.Uuid
  campaignId       String?    @db.Uuid
  date             DateTime   @db.Date
  totalImpressions Int        @default(0)
  totalClicks      Int        @default(0)
  totalSpend       Decimal    @default(0) @db.Decimal(15, 4)
  lastUpdated      DateTime   @default(now()) @updatedAt
  advertiser       Advertiser @relation(fields: [advertiserId], references: [id])
  campaign         Campaign?  @relation(fields: [campaignId], references: [id])

  @@unique([advertiserId, campaignId, date])
  @@index([advertiserId, date])
  @@index([campaignId, date])
  @@index([date])
  @@index([date, totalSpend])
  @@index([campaignId, totalSpend])
  @@index([date, totalImpressions])
  @@index([advertiserId, totalSpend])
}

model SystemDailyRevenue {
  id                    String   @id @default(uuid()) @db.Uuid
  date                  DateTime @unique @db.Date
  totalImpressions      Int      @default(0)
  totalClicks           Int      @default(0)
  totalGrossRevenue     Decimal  @default(0) @db.Decimal(18, 4)
  totalCommissionEarned Decimal  @default(0) @db.Decimal(18, 4)
  totalPublisherPayout  Decimal  @default(0) @db.Decimal(18, 4)
  activeCampaigns       Int      @default(0)
  activePublishers      Int      @default(0)
  activeAdvertisers     Int      @default(0)
  lastUpdated           DateTime @default(now()) @updatedAt

  @@index([date])
  @@index([totalGrossRevenue])
  @@index([totalImpressions])
}

model BudgetTransaction {
  id          String          @id @default(uuid()) @db.Uuid
  campaignId  String          @db.Uuid
  type        TransactionType
  amount      Decimal         @db.Decimal(12, 4)
  description String?
  publisherId String?         @db.Uuid
  inventoryId String?         @db.Uuid
  createdAt   DateTime        @default(now())
  campaign    Campaign        @relation(fields: [campaignId], references: [id])

  @@index([campaignId, createdAt])
  @@index([type, amount])
  @@index([campaignId, amount])
  @@index([type, createdAt])
  @@index([publisherId])
  @@index([inventoryId])
  @@index([campaignId, type, createdAt])
  @@index([publisherId, type, createdAt])
  @@index([inventoryId, type, createdAt])
}
