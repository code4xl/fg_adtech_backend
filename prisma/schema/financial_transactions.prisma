model PublisherRevenue {
    id           String  @id @default(uuid()) @db.Uuid
    publisherId  String  @db.Uuid
    campaignId   String  @db.Uuid
    inventoryId  String  @db.Uuid
    websiteId    String  @db.Uuid
    impressionId String? @db.Uuid
    clickId      String? @db.Uuid

    // Revenue details
    grossRevenue   Decimal @db.Decimal(10, 6)
    commissionRate Decimal @db.Decimal(3, 2)
    netRevenue     Decimal @db.Decimal(10, 6)

    // Event details
    eventType RevenueEventType
    createdAt DateTime         @default(now())

    // Relations
    campaign  Campaign    @relation(fields: [campaignId], references: [id])
    inventory AdInventory @relation(fields: [inventoryId], references: [id])
    website   Website     @relation(fields: [websiteId], references: [id])
    publisher Publisher   @relation(fields: [publisherId], references: [id])

    @@index([publisherId, createdAt])
    @@index([campaignId, createdAt])
    @@index([createdAt, eventType])
    @@index([inventoryId, createdAt])
    @@index([websiteId, createdAt])
    @@index([eventType])
}

model AdvertiserSpending {
    id           String           @id @default(uuid()) @db.Uuid
    advertiserId String           @db.Uuid
    campaignId   String           @db.Uuid
    creativeId   String           @db.Uuid
    clientId     String           @db.Uuid
    amount       Decimal          @db.Decimal(10, 6)
    impressionId String?          @db.Uuid
    clickId      String?          @db.Uuid
    eventType    RevenueEventType
    createdAt    DateTime         @default(now())

    // Relations
    campaign Campaign @relation(fields: [campaignId], references: [id])

    @@index([advertiserId, createdAt])
    @@index([campaignId, createdAt])
    @@index([eventType, createdAt])
    @@index([creativeId, createdAt])
    @@index([clientId, createdAt])
    @@index([eventType])
}

model SystemRevenue {
    id               String           @id @default(uuid()) @db.Uuid
    campaignId       String           @db.Uuid
    publisherId      String           @db.Uuid
    eventType        RevenueEventType
    grossRevenue     Decimal          @db.Decimal(10, 6)
    publisherShare   Decimal          @db.Decimal(10, 6)
    systemCommission Decimal          @db.Decimal(10, 6)
    commissionRate   Decimal          @db.Decimal(3, 2)

    inventoryId String   @db.Uuid
    createdAt   DateTime @default(now())

    // Relations
    campaign  Campaign    @relation(fields: [campaignId], references: [id])
    publisher Publisher   @relation(fields: [publisherId], references: [id])
    inventory AdInventory @relation(fields: [inventoryId], references: [id])

    @@index([campaignId, createdAt])
    @@index([publisherId, createdAt])
    @@index([inventoryId, createdAt])
}

model BudgetTransaction {
    id          String          @id @default(uuid()) @db.Uuid
    campaignId  String          @db.Uuid
    type        TransactionType
    amount      Decimal         @db.Decimal(10, 6)
    description String?

    impressionId String? @db.Uuid
    clickId      String? @db.Uuid

    publisherId String? @db.Uuid
    inventoryId String? @db.Uuid

    createdAt DateTime @default(now())

    // Relations
    campaign Campaign @relation(fields: [campaignId], references: [id])

    @@index([campaignId, createdAt])
    @@index([type, createdAt])
    @@index([impressionId])
    @@index([clickId])
    @@index([publisherId])
    @@index([inventoryId])
}
