model PublisherRevenue {
    id          String @id @default(uuid()) @db.Uuid
    publisherId String @db.Uuid
    campaignId  String @db.Uuid
    inventoryId String @db.Uuid
    websiteId   String @db.Uuid

    // Revenue details
    grossRevenue   Decimal @db.Decimal(10, 6)
    commissionRate Decimal @db.Decimal(3, 2)
    netRevenue     Decimal @db.Decimal(10, 6)

    // Event details
    eventType RevenueEventType
    createdAt DateTime         @default(now())

    // Relations
    campaign  Campaign    @relation(fields: [campaignId], references: [id])
    inventory AdInventory @relation(fields: [inventoryId], references: [id])
    website   Website     @relation(fields: [websiteId], references: [id])
    publisher Publisher   @relation(fields: [publisherId], references: [id])

    @@index([publisherId, createdAt])
    @@index([campaignId, createdAt])
    @@index([createdAt, eventType])
    @@index([inventoryId, createdAt])
    @@index([websiteId, createdAt])
    @@index([eventType])
}

model AdvertiserSpending {
    id           String           @id @default(uuid()) @db.Uuid
    advertiserId String           @db.Uuid
    campaignId   String           @db.Uuid
    creativeId   String           @db.Uuid
    clientId     String           @db.Uuid
    amount       Decimal          @db.Decimal(10, 6)
    eventType    RevenueEventType
    createdAt    DateTime         @default(now())

    // Relations
    campaign Campaign @relation(fields: [campaignId], references: [id])

    @@index([advertiserId, createdAt])
    @@index([campaignId, createdAt])
    @@index([eventType, createdAt])
    @@index([creativeId, createdAt])
    @@index([clientId, createdAt])
    @@index([eventType])
}

model SystemRevenue {
    id             String           @id @default(uuid()) @db.Uuid
    campaignId     String           @db.Uuid
    publisherId    String           @db.Uuid
    advertiserId   String           @db.Uuid
    creativeId     String           @db.Uuid
    eventType      RevenueEventType
    grossRevenue   Decimal          @db.Decimal(10, 6)
    publisherShare Decimal          @db.Decimal(10, 6)
    systemEarning  Decimal          @db.Decimal(10, 6)
    commissionRate Decimal          @db.Decimal(3, 2)

    inventoryId String   @db.Uuid
    createdAt   DateTime @default(now())

    // Relations
    campaign  Campaign    @relation(fields: [campaignId], references: [id])
    publisher Publisher   @relation(fields: [publisherId], references: [id])
    inventory AdInventory @relation(fields: [inventoryId], references: [id])

    @@index([campaignId, createdAt])
    @@index([publisherId, createdAt])
    @@index([inventoryId, createdAt])
}

model PublisherDailyRevenue {
    id          String   @id @default(uuid()) @db.Uuid
    publisherId String   @db.Uuid
    date        DateTime @db.Date

    // Aggregated metrics
    totalImpressions Int     @default(0)
    totalClicks      Int     @default(0)
    grossRevenue     Decimal @default(0) @db.Decimal(10, 2)
    netRevenue       Decimal @default(0) @db.Decimal(10, 2)
    commissionPaid   Decimal @default(0) @db.Decimal(10, 2)

    // Metadata
    lastUpdated DateTime @default(now()) @updatedAt

    // Relations
    publisher Publisher @relation(fields: [publisherId], references: [id])

    @@unique([publisherId, date])
    @@index([publisherId, date])
    @@index([date])
}

model AdvertiserDailySpending {
    id           String   @id @default(uuid()) @db.Uuid
    advertiserId String   @db.Uuid
    campaignId   String?  @db.Uuid
    date         DateTime @db.Date

    // Aggregated metrics
    totalImpressions Int     @default(0)
    totalClicks      Int     @default(0)
    totalSpend       Decimal @default(0) @db.Decimal(10, 4)

    // Metadata
    lastUpdated DateTime @default(now()) @updatedAt

    // Relations
    advertiser Advertiser @relation(fields: [advertiserId], references: [id])
    campaign   Campaign?  @relation(fields: [campaignId], references: [id])

    @@unique([advertiserId, campaignId, date])
    @@index([advertiserId, date])
    @@index([campaignId, date])
    @@index([date])
}

model SystemDailyRevenue {
    id   String   @id @default(uuid()) @db.Uuid
    date DateTime @db.Date

    // System-wide aggregated metrics
    totalImpressions      Int     @default(0)
    totalClicks           Int     @default(0)
    totalGrossRevenue     Decimal @default(0) @db.Decimal(10, 2)
    totalCommissionEarned Decimal @default(0) @db.Decimal(10, 2)
    totalPublisherPayout  Decimal @default(0) @db.Decimal(10, 2)

    // Metadata
    lastUpdated DateTime @default(now()) @updatedAt

    @@unique([date])
    @@index([date])
}

model BudgetTransaction {
    id          String          @id @default(uuid()) @db.Uuid
    campaignId  String          @db.Uuid
    type        TransactionType
    amount      Decimal         @db.Decimal(10, 6)
    description String?

    impressionId String? @db.Uuid
    clickId      String? @db.Uuid

    publisherId String? @db.Uuid
    inventoryId String? @db.Uuid

    createdAt DateTime @default(now())

    // Relations
    campaign Campaign @relation(fields: [campaignId], references: [id])

    @@index([campaignId, createdAt])
    @@index([type, createdAt])
    @@index([impressionId])
    @@index([clickId])
    @@index([publisherId])
    @@index([inventoryId])
}
