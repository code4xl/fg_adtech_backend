model DemographicTargeting {
  id          String        @id @default(uuid()) @db.Uuid
  campaignId  String?       @db.Uuid
  inventoryId String?       @db.Uuid
  ageMin      Int?
  ageMax      Int?
  languages   Language[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  incomeRange IncomeRange[]
  genders     Gender[]
  education   Education[]
  campaign    Campaign?     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  inventory   AdInventory?  @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([inventoryId])
  @@index([ageMin, ageMax])
  @@index([ageMin, ageMax, campaignId])
}

model GeographicTargeting {
  id          String       @id @default(uuid()) @db.Uuid
  campaignId  String?      @db.Uuid
  inventoryId String?      @db.Uuid
  countries   String[]
  states      String[]
  cities      String[]
  postalCodes String[]
  radius      Int?
  latitude    Float?
  longitude   Float?
  isInclude   Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  campaign    Campaign?    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  inventory   AdInventory? @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([inventoryId])
  @@index([countries])
  @@index([countries, campaignId])
}

model DeviceTargeting {
  id               String            @id @default(uuid()) @db.Uuid
  campaignId       String?           @db.Uuid
  inventoryId      String?           @db.Uuid
  minOSVersion     String?
  maxOSVersion     String?
  deviceModels     String[]
  isInclude        Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deviceTypes      DeviceType[]
  operatingSystems OperatingSystem[]
  browsers         BrowserType[]
  connectionTypes  ConnectionType[]
  campaign         Campaign?         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  inventory        AdInventory?      @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([inventoryId])
  @@index([deviceTypes])
  @@index([deviceTypes, campaignId])
}

model ContextualTargeting {
  id                String             @id @default(uuid()) @db.Uuid
  campaignId        String?            @db.Uuid
  inventoryId       String?            @db.Uuid
  contentCategories BusinessCategory[]
  keywords          String[]
  urlPatterns       String[]
  blockedKeywords   String[]
  isInclude         Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  pageTypes         PageType[]
  brandSafety       BrandSafety[]
  campaign          Campaign?          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  inventory         AdInventory?       @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([inventoryId])
  @@index([contentCategories])
}

model BehavioralTargeting {
  id                String              @id @default(uuid()) @db.Uuid
  campaignId        String?             @db.Uuid
  inventoryId       String?             @db.Uuid
  interests         CampaignInterest[]
  avgOrderValue     Decimal?            @db.Decimal(10, 2)
  sessionDuration   Int?
  pageViews         Int?
  isInclude         Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  audienceTypes     AudienceType[]
  sessionEngagement SessionEngagement[]
  userSegments      UserSegment[]
  purchaseIntent    PurchaseIntent[]
  lifestyleSegments LifestyleSegment[]
  purchaseFrequency PurchaseFrequency[]
  campaign          Campaign?           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  inventory         AdInventory?        @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([inventoryId])
  @@index([interests])
}

model TimeTargeting {
  id              String        @id @default(uuid()) @db.Uuid
  campaignId      String?       @db.Uuid
  inventoryId     String?       @db.Uuid
  timezone        String        @default("Asia/Kolkata")
  startHour       Int?
  endHour         Int?
  startDate       DateTime?
  endDate         DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  holidayTypes    HolidayType[]
  includeHolidays Boolean       @default(true)
  timeSlots       TimeSlot[]
  workingDaysOnly Boolean       @default(false)
  daysOfWeek      DayOfWeek[]
  campaign        Campaign?     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  inventory       AdInventory?  @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([inventoryId])
  @@index([startHour, endHour])
  @@index([daysOfWeek, campaignId])
}

model FrequencyTargeting {
  id                    String          @id @default(uuid()) @db.Uuid
  campaignId            String?         @db.Uuid
  inventoryId           String?         @db.Uuid
  maxImpressions        Int
  maxClicksPerUser      Int?
  minTimeBetween        Int?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  customTimeWindowHours Int?
  frequencyScope        FrequencyScope
  frequencyWindow       FrequencyWindow
  campaign              Campaign?       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  inventory             AdInventory?    @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([inventoryId])
}
