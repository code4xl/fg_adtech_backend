model InventoryTargetingRule {
  id          String            @id @default(uuid()) @db.Uuid
  inventoryId String            @db.Uuid
  ruleType    TargetingRuleType
  ruleData    Json
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  // Relations
  inventory AdInventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
}

// Campaign targeting rules
model CampaignTargetingRule {
  id         String            @id @default(uuid()) @db.Uuid
  campaignId String            @db.Uuid
  ruleType   TargetingRuleType
  ruleData   Json
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  // Relations
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

enum TargetingRuleType {
  DEMOGRAPHIC
  GEOGRAPHIC
  DEVICE
  CONTEXTUAL
  BEHAVIORAL
  TIME
  FREQUENCY
}
