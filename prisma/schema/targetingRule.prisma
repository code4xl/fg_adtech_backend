// UPDATED TARGETING RULES WITH PROPER ENUMS
// Replace the existing targetingRules.prisma.txt with this version

// DEMOGRAPHIC TARGETING
model DemographicTargeting {
  id          String  @id @default(uuid()) @db.Uuid
  campaignId  String? @db.Uuid
  inventoryId String? @db.Uuid

  // Demographic fields with proper enums
  ageMin      Int?
  ageMax      Int?
  genders     Gender[]
  languages   Language[]
  education   Education[]
  incomeRange IncomeRange[] // Using enum instead of min/max integers

  // Relationship
  campaign  Campaign?    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  inventory AdInventory? @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId])
  @@index([inventoryId])
  @@index([ageMin, ageMax])
}

// GEOGRAPHIC TARGETING
model GeographicTargeting {
  id          String  @id @default(uuid()) @db.Uuid
  campaignId  String? @db.Uuid
  inventoryId String? @db.Uuid

  // Geographic fields with proper enums
  countries   String[] // Using ISO 3166-1 alpha-2 codes for countries
  states      String[] // For Indian states, could be extended for other countries
  cities      String[] // Keep as string since city names vary widely
  postalCodes String[]
  radius      Int? // Radius in KM for location targeting
  latitude    Float?
  longitude   Float?

  // Include/Exclude logic
  isInclude Boolean @default(true) // true = include, false = exclude

  // Relationships
  campaign  Campaign?    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  inventory AdInventory? @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId])
  @@index([inventoryId])
  @@index([countries])
}

// DEVICE TARGETING
model DeviceTargeting {
  id          String  @id @default(uuid()) @db.Uuid
  campaignId  String? @db.Uuid
  inventoryId String? @db.Uuid

  // Device fields with proper enums
  deviceTypes      DeviceType[]
  operatingSystems OperatingSystem[]
  browsers         BrowserType[]
  connectionTypes  ConnectionType[]

  // Mobile specific
  minOSVersion String?
  maxOSVersion String?
  deviceModels String[] // Keep as string since device models vary widely

  // Include/Exclude logic
  isInclude Boolean @default(true)

  // Relationships
  campaign  Campaign?    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  inventory AdInventory? @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId])
  @@index([inventoryId])
  @@index([deviceTypes])
}

// CONTEXTUAL TARGETING
model ContextualTargeting {
  id          String  @id @default(uuid()) @db.Uuid
  campaignId  String? @db.Uuid
  inventoryId String? @db.Uuid

  // Context fields with proper enums
  contentCategories BusinessCategory[]
  keywords          String[] // Keywords to match in page content
  urlPatterns       String[] // URL patterns to match
  pageTypes         PageType[]
  brandSafety       BrandSafety[]

  // Content safety
  blockedKeywords String[] // Keywords to avoid

  // Include/Exclude logic
  isInclude Boolean @default(true)

  // Relationships
  campaign  Campaign?    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  inventory AdInventory? @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId])
  @@index([inventoryId])
  @@index([contentCategories])
}

// BEHAVIORAL TARGETING
model BehavioralTargeting {
  id          String  @id @default(uuid()) @db.Uuid
  campaignId  String? @db.Uuid
  inventoryId String? @db.Uuid

  // Behavioral fields with proper enums
  interests         CampaignInterest[]
  purchaseIntent    PurchaseIntent[]
  lifestyleSegments LifestyleSegment[]
  audienceTypes     AudienceType[]
  userSegments      UserSegment[]

  // Shopping behavior with enums
  purchaseFrequency PurchaseFrequency[]
  sessionEngagement SessionEngagement[]

  // Numeric thresholds
  avgOrderValue   Decimal? @db.Decimal(10, 2)
  sessionDuration Int? // Minutes
  pageViews       Int? // Average page views per session

  // Include/Exclude logic
  isInclude Boolean @default(true)

  // Relationships
  campaign  Campaign?    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  inventory AdInventory? @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId])
  @@index([inventoryId])
  @@index([interests])
}

// TIME TARGETING
model TimeTargeting {
  id          String  @id @default(uuid()) @db.Uuid
  campaignId  String? @db.Uuid
  inventoryId String? @db.Uuid

  // Time fields with proper enums
  timezone     String        @default("Asia/Kolkata")
  timeSlots    TimeSlot[] // Predefined time slots
  daysOfWeek   DayOfWeek[] // Using enum instead of integers
  holidayTypes HolidayType[]

  // Fine-grained control (optional)
  startHour Int? // 0-23
  endHour   Int? // 0-23
  startDate DateTime?
  endDate   DateTime?

  // Special time periods
  includeHolidays Boolean @default(true)
  workingDaysOnly Boolean @default(false)

  // Relationships
  campaign  Campaign?    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  inventory AdInventory? @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId])
  @@index([inventoryId])
  @@index([startHour, endHour])
}

// FREQUENCY TARGETING
model FrequencyTargeting {
  id          String  @id @default(uuid()) @db.Uuid
  campaignId  String? @db.Uuid
  inventoryId String? @db.Uuid

  // Frequency fields with proper enums
  maxImpressions  Int
  frequencyWindow FrequencyWindow // Using enum instead of hours
  frequencyScope  FrequencyScope // Using enum for scope

  // Advanced frequency
  maxClicksPerUser Int?
  minTimeBetween   Int? // Minimum minutes between impressions

  // Custom time window (if needed beyond enum)
  customTimeWindowHours Int? // For flexibility

  // Relationships
  campaign  Campaign?    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  inventory AdInventory? @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId])
  @@index([inventoryId])
}
