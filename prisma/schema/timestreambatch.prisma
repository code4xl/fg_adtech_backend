model TimestreamBatch {
    id           String    @id @default(uuid()) @db.Uuid
    batchType    String // 'impressions', 'clicks', 'bids'
    recordCount  Int
    batchSize    Int
    status       String // 'PENDING', 'PROCESSING', 'COMPLETED', 'FAILED'
    startTime    DateTime  @default(now())
    endTime      DateTime?
    errorMessage String?

    @@index([batchType, status])
    @@index([startTime])
}
