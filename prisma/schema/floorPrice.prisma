model FloorPrice {
  id          String      @id @default(uuid()) @db.Uuid
  inventoryId String      @db.Uuid
  basePrice   Decimal     @db.Decimal(10, 4)
  startDate   DateTime
  endDate     DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  currency    Currency    @default(INR)
  inventory   AdInventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
}
