model AuctionOptimization {
    id          String @id @default(uuid()) @db.Uuid
    inventoryId String @db.Uuid

    // Dynamic pricing
    recommendedFloor Decimal @db.Decimal(10, 4)
    avgWinningBid    Decimal @db.Decimal(10, 4)

    // Performance indicators
    fillRate        Float // % of requests that get bids
    competitiveness Float // How competitive this inventory is

    // Time-based data
    hourOfDay Int // 0-23
    dayOfWeek Int // 1-7

    lastCalculated DateTime @default(now())

    inventory AdInventory @relation(fields: [inventoryId], references: [id])

    @@unique([inventoryId, hourOfDay, dayOfWeek])
}
