model AuctionLog {
  id              String        @id @default(uuid()) @db.Uuid
  bidRequestId    String        @unique @db.Uuid
  winningBidId    String?       @db.Uuid
  floorPrice      Decimal?      @db.Decimal(10, 4)
  finalPrice      Decimal?      @db.Decimal(10, 4)
  totalBids       Int           @default(0)
  auctionDuration Int?
  errorMessage    String?
  debugData       Json?
  auctionType     AuctionType
  completedAt     DateTime?
  startedAt       DateTime      @default(now())
  validBids       Int           @default(0)
  status          AuctionStatus @default(PROCESSING)
  bidRequest      BidRequest    @relation(fields: [bidRequestId], references: [id], onDelete: Cascade)

  @@index([status, startedAt])
  @@index([completedAt])
}
