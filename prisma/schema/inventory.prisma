model AdInventory {
  id                   String                 @id @default(uuid()) @db.Uuid
  publisherId          String                 @db.Uuid
  name                 String
  isActive             Boolean                @default(true)
  adSlotTemplateId     String                 @db.Uuid
  adSlotTemplate       AdSlotTemplate         @relation(fields: [adSlotTemplateId], references: [id])
  viewabilityScore     Float?
  approvalStatus       ApprovalStatus         @default(PENDING)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  websiteId            String                 @db.Uuid
  adSlotScript         String?
  containerHTML        String?
  publisher            Publisher              @relation(fields: [publisherId], references: [id])
  floorPrices          FloorPrice[]
  bidRequests          BidRequest[]
  demographicTargeting DemographicTargeting[]
  geographicTargeting  GeographicTargeting[]
  deviceTargeting      DeviceTargeting[]
  contextualTargeting  ContextualTargeting[]
  behavioralTargeting  BehavioralTargeting[]
  timeTargeting        TimeTargeting[]
  frequencyTargeting   FrequencyTargeting[]
  hourlyMetrics        HourlyMetrics[]
  website              Website                @relation(fields: [websiteId], references: [id])

  ImpressionEvent ImpressionEvent[]

  ClickEvent ClickEvent[]

  @@index([id, publisherId], name: "inventory_publisher_idx")
  @@index([adSlotTemplateId, isActive], name: "inventory_template_active_idx")
  @@index([publisherId, isActive, approvalStatus], name: "inventory_eligible_idx")
}
