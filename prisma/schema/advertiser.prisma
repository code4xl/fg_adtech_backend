// This is your updated Prisma schema file,
// showing the additions needed for authentication

model Advertiser {
    id                   String      @id @default(uuid()) @db.Uuid
    name                 String
    email                String      @unique
    emailVerifiedAt      DateTime? // Changed to nullable for verification workflow
    password             String
    rememberToken        String? // Nullable
    mobile               String      @unique
    companyName          String
    hqLocation           String
    companySize          CompanySize
    createdAt            DateTime    @default(now())
    updatedAt            DateTime    @updatedAt
    // Added fields for authentication
    verificationToken    String?     @unique // For email verification
    resetPasswordToken   String?     @unique // For password reset
    resetPasswordExpires DateTime? // Password reset token expiration
    // MFA fields
    mfaEnabled           Boolean     @default(false)
    mfaVerificationCode  String?
    mfaCodeExpiry        DateTime?
    clients              Client[] // Relationship with Client

    // Relations
    blockedInventories InventoryBlockedAdvertiser[]
    Campaign           Campaign[]

    bidResponses BidResponse[]

    Impression Impression[]
}
