// This is your updated Prisma schema file,
// showing the additions needed for authentication

enum AdvertiserCompanySize {
    ONE_TO_TEN // 1-10
    ELEVEN_TO_FIFTY // 11-50
    FIFTY_ONE_TO_TWO_HUNDRED // 51-200
    TWO_HUNDRED_ONE_TO_FIVE_HUNDRED // 201-500
    FIVE_HUNDRED_ONE_TO_ONE_THOUSAND // 501-1000
    ONE_THOUSAND_AND_ABOVE // 1001+
}

model Advertiser {
    id                   Int                   @id @default(autoincrement())
    name                 String
    email                String                @unique
    emailVerifiedAt      DateTime? // Changed to nullable for verification workflow
    password             String
    rememberToken        String? // Nullable
    mobile               String                @unique
    companyName          String
    hqLocation           String
    companySize          AdvertiserCompanySize
    createdAt            DateTime              @default(now())
    updatedAt            DateTime              @updatedAt
    // Added fields for authentication
    verificationToken    String?               @unique // For email verification
    resetPasswordToken   String?               @unique // For password reset
    resetPasswordExpires DateTime? // Password reset token expiration
}
