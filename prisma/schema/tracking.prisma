// prisma/schema/tracking.prisma

// Impression tracking table (optimized for TimescaleDB)
model ImpressionTrack {
    id            String   @id @default(uuid()) @db.Uuid
    timestamp     DateTime @default(now())
    creativeId    String   @db.Uuid
    campaignId    String   @db.Uuid
    inventoryId   String   @db.Uuid
    publisherId   String   @db.Uuid
    bidRequestId  String?  @db.Uuid
    bidResponseId String?  @db.Uuid
    price         Decimal? @db.Decimal(10, 4)
    ipAddress     String?
    userAgent     String?
    referrer      String?
    country       String?
    region        String?
    city          String?
    deviceType    String?
    browserType   String?
    viewable      Boolean?
    viewTime      Int? // Time in milliseconds ad was visible

    // Additional metadata
    metadata Json?

    // Indexes (important for TimescaleDB)
    // Index combinations for common queries
    @@index([timestamp])
    @@index([campaignId, timestamp])
    @@index([inventoryId, timestamp])
    @@index([publisherId, timestamp])
    @@index([creativeId, campaignId, timestamp])
    @@index([inventoryId, publisherId, timestamp])
    @@index([country, region, timestamp])
    @@index([deviceType, timestamp])
}

// Click tracking table (optimized for TimescaleDB)
model ClickTrack {
    id                String   @id @default(uuid()) @db.Uuid
    timestamp         DateTime @default(now())
    creativeId        String   @db.Uuid
    campaignId        String   @db.Uuid
    inventoryId       String   @db.Uuid
    publisherId       String   @db.Uuid
    impressionTrackId String?  @db.Uuid
    ipAddress         String?
    userAgent         String?
    referrer          String?
    country           String?
    region            String?
    city              String?
    deviceType        String?
    browserType       String?

    // Additional metadata
    metadata Json?

    // Indexes (important for TimescaleDB)
    @@index([timestamp])
    @@index([campaignId, timestamp])
    @@index([inventoryId, timestamp])
    @@index([publisherId, timestamp])
    @@index([creativeId, campaignId, timestamp])
    @@index([country, timestamp])
}

// Aggregated hourly stats with additional metrics
model HourlyStats {
    id          String   @id @default(uuid()) @db.Uuid
    hour        DateTime // Rounded to hour (timestamp without minutes, seconds)
    campaignId  String?  @db.Uuid
    inventoryId String?  @db.Uuid
    publisherId String?  @db.Uuid
    impressions Int      @default(0)
    clicks      Int      @default(0)
    spend       Decimal  @default(0) @db.Decimal(10, 4)
    // New denormalized metrics
    ctr         Float? // Precomputed CTR for faster reporting
    cpc         Decimal? @db.Decimal(10, 4) // Precomputed CPC
    ecpm        Decimal? @db.Decimal(10, 4) // Precomputed eCPM

    // Indexes
    @@unique([hour, campaignId, inventoryId, publisherId])
    @@index([hour])
    @@index([campaignId, hour])
    @@index([inventoryId, hour])
    @@index([publisherId, hour])
    @@index([hour, campaignId, inventoryId]) // Combined index for common queries
}

// New daily aggregation table for faster reporting
model DailyStats {
    id          String   @id @default(uuid()) @db.Uuid
    date        DateTime @db.Date // Just the date without time
    campaignId  String?  @db.Uuid
    inventoryId String?  @db.Uuid
    publisherId String?  @db.Uuid
    impressions Int      @default(0)
    clicks      Int      @default(0)
    spend       Decimal  @default(0) @db.Decimal(10, 4)
    revenue     Decimal  @default(0) @db.Decimal(10, 4)
    ctr         Float    @default(0) // Precomputed click-through rate
    cpc         Decimal  @default(0) @db.Decimal(10, 4) // Cost per click
    ecpm        Decimal  @default(0) @db.Decimal(10, 4) // Effective CPM

    @@unique([date, campaignId, inventoryId, publisherId])
    @@index([date])
    @@index([campaignId, date])
    @@index([inventoryId, date])
    @@index([publisherId, date])
}
