model TimescaleSyncLog {
  id           String   @id @default(uuid()) @db.Uuid
  tableName    String
  lastSyncTime DateTime
  recordCount  Int
  status       String
  errorMessage String?
  createdAt    DateTime @default(now())

  @@index([tableName, lastSyncTime])
}

model ImpressionEvent {
  id                String       @id @default(uuid()) @db.Uuid
  creativeId        String       @db.Uuid
  bidResponseId     String       @db.Uuid
  campaignId        String       @db.Uuid
  advertiserId      String       @db.Uuid
  inventoryId       String       @db.Uuid
  publisherId       String       @db.Uuid
  websiteId         String       @db.Uuid
  timestamp         DateTime     @default(now())
  userAgent         String?
  ipAddress         String?
  deviceType        String?
  viewable          Boolean?
  viewTime          BigInt?
  isBot             Boolean?     @default(false)
  fraudScore        Float?
  syncedAt          DateTime?
  syncedToTimescale Boolean      @default(false)
  createdAt         DateTime     @default(now())
  city              String?
  country           String?
  region            String?
  bidPrice          Float?
  slotId            String?      @db.VarChar(100)
  userFingerprint   String?      @db.VarChar(50)
  templateId        String?      @db.Uuid
  finalPrice        Float?
  ClickEvent        ClickEvent[]
  campaign          Campaign     @relation(fields: [campaignId], references: [id])
  creative          Creative     @relation(fields: [creativeId], references: [id])
  inventory         AdInventory  @relation(fields: [inventoryId], references: [id])
  publisher         Publisher    @relation(fields: [publisherId], references: [id])

  @@index([creativeId, timestamp])
  @@index([campaignId, timestamp])
  @@index([inventoryId, timestamp])
  @@index([publisherId, timestamp])
  @@index([timestamp])
  @@index([syncedToTimescale])
}

model ClickEvent {
  id                 String           @id @default(uuid()) @db.Uuid
  impressionId       String?          @db.Uuid
  creativeId         String           @db.Uuid
  bidResponseId      String           @db.Uuid
  campaignId         String           @db.Uuid
  advertiserId       String           @db.Uuid
  inventoryId        String           @db.Uuid
  publisherId        String           @db.Uuid
  websiteId          String           @db.Uuid
  timestamp          DateTime         @default(now())
  userAgent          String?
  ipAddress          String?
  deviceType         String?
  landingUrl         String?
  isBot              Boolean?         @default(false)
  fraudScore         Float?
  timeFromImpression Int?
  syncedAt           DateTime?
  syncedToTimescale  Boolean          @default(false)
  createdAt          DateTime         @default(now())
  city               String?
  country            String?
  region             String?
  slotId             String?          @db.VarChar(100)
  userFingerprint    String?          @db.VarChar(50)
  templateId         String?          @db.Uuid
  campaign           Campaign         @relation(fields: [campaignId], references: [id])
  creative           Creative         @relation(fields: [creativeId], references: [id])
  impression         ImpressionEvent? @relation(fields: [impressionId], references: [id])
  inventory          AdInventory      @relation(fields: [inventoryId], references: [id])
  publisher          Publisher        @relation(fields: [publisherId], references: [id])

  @@index([creativeId, timestamp])
  @@index([campaignId, timestamp])
  @@index([inventoryId, timestamp])
  @@index([publisherId, timestamp])
  @@index([impressionId])
  @@index([timestamp])
  @@index([syncedToTimescale])
}
