model Website {
  id                String             @id @default(uuid()) @db.Uuid
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  publisherId       String             @db.Uuid
  description       String?
  domain            String?            @unique
  initScript        String?
  isActive          Boolean            @default(true)
  name              String
  url               String?            @unique
  cdnURL            String?
  inventories       AdInventory[]
  bidRequests       BidRequest[]
  PublisherRevenue  PublisherRevenue[]
  publisher         Publisher          @relation(fields: [publisherId], references: [id], onDelete: Cascade)
  websiteCategories ContentCategory[]  @relation("ContentCategoryToWebsite")

  @@index([publisherId, url], map: "idx_website_publisher_url")
}
