model BidResponse {
    id                    String   @id @default(uuid()) @db.Uuid
    bidRequestId          String   @db.Uuid
    campaignId            String   @db.Uuid
    creativeId            String   @db.Uuid
    advertiserId          String   @db.Uuid
    bidPrice              Decimal  @db.Decimal(10, 4) // The bid amount
    currency              String   @default("USD")
    bidTimestamp          DateTime @default(now())
    status                String   @default("PENDING") // PENDING, WON, LOST, TIMEOUT, ERROR
    responseTime          Int? // Response time in milliseconds
    winNoticed            Boolean  @default(false) // Whether the win notice was sent
    adMarkup              String? // The actual ad markup/creative to display
    impressionTrackingUrl String? // URL for tracking impressions
    clickTrackingUrl      String? // URL for tracking clicks
    createdAt             DateTime @default(now())
    updatedAt             DateTime @updatedAt

    // Relations
    bidRequest BidRequest  @relation(fields: [bidRequestId], references: [id], onDelete: Cascade)
    campaign   Campaign    @relation(fields: [campaignId], references: [id])
    creative   Creative    @relation(fields: [creativeId], references: [id])
    advertiser Advertiser  @relation(fields: [advertiserId], references: [id])
    auctionLog AuctionLog? // Optional relation to auction log
}

// Key fields:

// bidRequestId: Links to the original request this is responding to
// campaignId, creativeId, advertiserId: Identify which campaign is bidding and with what creative
// bidPrice: The amount the advertiser is willing to pay for this impression
// status: Tracks whether this bid is pending, won, lost, etc.
// responseTime: How long it took to generate this bid (for performance monitoring)
// winNoticed: Whether the "win notice" has been sent to the bidder if they won
// adMarkup: The actual HTML/code that will be displayed if this bid wins

// How it's used:
// When the RTB system receives a bid request, it evaluates which campaigns should bid on it based on targeting parameters. For each eligible campaign, it creates a bid response with the campaign's bid price and the creative to display.
