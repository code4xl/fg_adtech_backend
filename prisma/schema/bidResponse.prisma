model BidResponse {
  id                  String     @id @default(uuid()) @db.Uuid
  bidRequestId        String     @db.Uuid
  campaignId          String     @db.Uuid
  creativeId          String     @db.Uuid
  advertiserId        String     @db.Uuid
  bidPrice            Decimal    @db.Decimal(10, 4)
  adMarkup            String?
  createdAt           DateTime   @default(now())
  clickUrls           String[]
  finalPrice          Decimal?   @db.Decimal(10, 4)
  impressionUrls      String[]
  processedAt         DateTime?
  responseLatency     Int?
  winNotificationSent Boolean    @default(false)
  status              BidStatus  @default(PENDING)
  currency            Currency   @default(INR)
  landingUrl          String
  cpi                 Decimal?   @db.Decimal(10, 4)
  advertiser          Advertiser @relation(fields: [advertiserId], references: [id])
  bidRequest          BidRequest @relation(fields: [bidRequestId], references: [id], onDelete: Cascade)
  campaign            Campaign   @relation(fields: [campaignId], references: [id])
  creative            Creative   @relation(fields: [creativeId], references: [id])

  @@index([bidRequestId])
  @@index([campaignId, createdAt])
  @@index([status, createdAt])
}
