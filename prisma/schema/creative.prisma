model Creative {
  id                     String            @id @default(uuid()) @db.Uuid
  campaignId             String            @db.Uuid
  name                   String
  type                   CreativeType
  fileUrl                String
  s3Key                  String?
  landingUrl             String
  status                 CreativeStatus    @default(PENDING_REVIEW)
  reviewNotes            String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  contentSafetyThreshold Float?
  templateId             String            @db.Uuid
  bidResponses           BidResponse[]
  ClickEvent             ClickEvent[]
  campaign               Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  adSlotTemplate         AdSlotTemplate    @relation(fields: [templateId], references: [id])
  ImpressionEvent        ImpressionEvent[]

  @@index([campaignId, status])
  @@index([templateId, status])
  @@index([status, campaignId, templateId])
}
