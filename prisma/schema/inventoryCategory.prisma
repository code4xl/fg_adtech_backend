model InventoryCategory {
  inventoryId       String              @db.Uuid
  categoryId        String              @db.Uuid
  createdAt         DateTime           @default(now())

  // Relations
  inventory         AdInventory        @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  category          ContentCategory    @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([inventoryId, categoryId])
}