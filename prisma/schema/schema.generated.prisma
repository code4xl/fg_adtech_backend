model AdInventory {
  id               String            @id @default(uuid()) @db.Uuid
  publisherId      String            @db.Uuid
  name             String
  width            Int
  height           Int
  format           InventoryFormat
  position         InventoryPosition
  isActive         Boolean           @default(true)
  viewabilityScore Float?
  approvalStatus   ApprovalStatus    @default(PENDING)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  // Relations
  publisher          Publisher                    @relation(fields: [publisherId], references: [id])
  floorPrices        FloorPrice[]
  categories         InventoryCategory[]
  blockedAdvertisers InventoryBlockedAdvertiser[]
  availability       InventoryAvailability[]
  bidRequests        BidRequest[]
  impressions        Impression[]
  targetingRules     InventoryTargetingRule[]
  creatives          Creative[]
  CampaignInventory  CampaignInventory[]
}

model ContentCategory {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  parentId    String?  @db.Uuid
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  parentCategory  ContentCategory?    @relation("CategoryHierarchy", fields: [parentId], references: [id])
  childCategories ContentCategory[]   @relation("CategoryHierarchy")
  inventories     InventoryCategory[]
  publishers      PublisherCategory[]
}

// Creative model for ads
model Creative {
  id          String         @id @default(uuid()) @db.Uuid
  campaignId  String         @db.Uuid
  inventoryId String         @db.Uuid
  name        String
  type        CreativeType
  width       Int
  height      Int
  fileUrl     String
  landingUrl  String
  status      CreativeStatus @default(PENDING_REVIEW)
  reviewNotes String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // Relations
  campaign     Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  inventory    AdInventory   @relation(fields: [inventoryId], references: [id])
  bidResponses BidResponse[]
}

model FloorPrice {
  id             String    @id @default(uuid()) @db.Uuid
  inventoryId    String    @db.Uuid
  basePrice      Decimal   @db.Decimal(10, 2)
  currency       String    @default("USD")
  startDate      DateTime
  endDate        DateTime?
  timeTargeting  Json?
  buyerTargeting Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  inventory AdInventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
}

model Impression {
  id          String   @id @default(uuid()) @db.Uuid
  inventoryId String   @db.Uuid
  createdAt   DateTime @default(now())
  // Add other impression fields as needed

  // Relations
  inventory AdInventory @relation(fields: [inventoryId], references: [id])
  clicks    Click[] // Add this line
}

model InventoryAvailability {
  id                   String   @id @default(uuid()) @db.Uuid
  inventoryId          String   @db.Uuid
  date                 DateTime @db.Date
  totalImpressions     Int
  reservedImpressions  Int      @default(0)
  availableImpressions Int
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  // Relations
  inventory AdInventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@unique([inventoryId, date])
}

model InventoryBlockedAdvertiser {
  inventoryId  String   @db.Uuid
  advertiserId String   @db.Uuid
  createdAt    DateTime @default(now())

  // Relations
  inventory  AdInventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  advertiser Advertiser  @relation(fields: [advertiserId], references: [id], onDelete: Cascade)

  @@id([inventoryId, advertiserId])
}

model InventoryCategory {
  inventoryId String   @db.Uuid
  categoryId  String   @db.Uuid
  createdAt   DateTime @default(now())

  // Relations
  inventory AdInventory     @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  category  ContentCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([inventoryId, categoryId])
}

model InventoryTargetingRule {
  id          String            @id @default(uuid()) @db.Uuid
  inventoryId String            @db.Uuid
  ruleType    TargetingRuleType
  ruleData    Json
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  // Relations
  inventory AdInventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
}

model PublisherCategory {
  publisherId String   @db.Uuid
  categoryId  String   @db.Uuid
  createdAt   DateTime @default(now())

  // Relations
  publisher Publisher       @relation(fields: [publisherId], references: [id], onDelete: Cascade)
  category  ContentCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([publisherId, categoryId])
}

model PublisherLanguage {
  publisherId String   @db.Uuid
  language    Language
  createdAt   DateTime @default(now())

  // Relations
  publisher Publisher @relation(fields: [publisherId], references: [id], onDelete: Cascade)

  @@id([publisherId, language])
}

model Publisher {
  id              String          @id @default(uuid()) @db.Uuid
  firstName       String
  lastName        String
  email           String          @unique
  emailVerifiedAt DateTime?
  password        String
  rememberToken   String?
  domain          String?
  status          PublisherStatus @default(ACTIVE)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  // Relations
  inventories AdInventory[]
  categories  PublisherCategory[]
  languages   PublisherLanguage[]
  bidRequests BidRequest[]
}

model AuctionLog {
  id               String           @id @default(uuid()) @db.Uuid
  bidRequestId     String           @db.Uuid
  winningBidId     String?          @unique @db.Uuid // Unique to ensure only one winner
  floorPrice       Decimal?         @db.Decimal(10, 4)
  finalPrice       Decimal?         @db.Decimal(10, 4) // The final price (might be different from bid in second-price auctions)
  totalBids        Int              @default(0)
  auctionStartTime DateTime         @default(now())
  auctionEndTime   DateTime?
  auctionDuration  Int? // Duration in milliseconds
  status           AuctionLogStatus @default(STARTED) // PENDING, COMPLETED, ERROR
  errorMessage     String?
  debugData        Json? // Additional debugging information
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  // Relations
  bidRequest BidRequest   @relation(fields: [bidRequestId], references: [id], onDelete: Cascade)
  winningBid BidResponse? @relation(fields: [winningBidId], references: [id])
}

model BidRequest {
  id               String      @id @default(uuid()) @db.Uuid
  requestId        String      @unique // Unique ID for external reference
  inventoryId      String      @db.Uuid
  publisherId      String      @db.Uuid
  userAgent        String?
  ipAddress        String?
  deviceType       String?
  browserType      String?
  country          String?
  region           String?
  city             String?
  requestTimestamp DateTime    @default(now())
  floor            Decimal?    @db.Decimal(10, 4) // Minimum bid price
  auctionType      AuctionType @default(FIRST_PRICE) // FIRST_PRICE or SECOND_PRICE
  timeout          Int         @default(200) // Timeout in milliseconds
  targeting        Json? // Additional targeting parameters
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  // Relations
  inventory    AdInventory   @relation(fields: [inventoryId], references: [id])
  publisher    Publisher     @relation(fields: [publisherId], references: [id])
  bidResponses BidResponse[] // Relation to bid responses
  auctionLogs  AuctionLog[] // Relation to auction logs
}

model BidResponse {
  id           String   @id @default(uuid()) @db.Uuid
  bidRequestId String   @db.Uuid
  campaignId   String   @db.Uuid
  creativeId   String   @db.Uuid
  advertiserId String   @db.Uuid
  bidPrice     Decimal  @db.Decimal(10, 4) // The bid amount
  currency     String   @default("USD")
  bidTimestamp DateTime @default(now())
  status       String   @default("PENDING") // PENDING, WON, LOST, TIMEOUT, ERROR
  responseTime Int? // Response time in milliseconds
  winNoticed   Boolean  @default(false) // Whether the win notice was sent
  adMarkup     String? // The actual ad markup/creative to display
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  bidRequest BidRequest  @relation(fields: [bidRequestId], references: [id], onDelete: Cascade)
  campaign   Campaign    @relation(fields: [campaignId], references: [id])
  creative   Creative    @relation(fields: [creativeId], references: [id])
  advertiser Advertiser  @relation(fields: [advertiserId], references: [id])
  auctionLog AuctionLog? // Optional relation to auction log
}
