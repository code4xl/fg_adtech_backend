// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client-js"
  output          = "../../node_modules/.prisma/client"
  previewFeatures = ["prismaSchemaFolder"]
  binaryTargets   = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id       String @id @default(uuid()) @db.Uuid
  name     String
  email    String @unique
  password String
}

// This is your updated Prisma schema file,
// showing the additions needed for authentication

model Advertiser {
  id                   String      @id @default(uuid()) @db.Uuid
  name                 String
  email                String      @unique
  emailVerifiedAt      DateTime? // Changed to nullable for verification workflow
  password             String
  rememberToken        String? // Nullable
  mobile               String      @unique
  companyName          String
  hqLocation           String
  companySize          CompanySize
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  // Added fields for authentication
  verificationToken    String?     @unique // For email verification
  resetPasswordToken   String?     @unique // For password reset
  resetPasswordExpires DateTime? // Password reset token expiration
  clients              Client[] // Relationship with Client

  // Relations
  blockedInventories InventoryBlockedAdvertiser[]
  Campaign           Campaign[]

  bidResponses BidResponse[]
}

// Campaign model
model Campaign {
  id               String             @id @default(uuid()) @db.Uuid
  name             String
  advertiserId     String             @db.Uuid
  clientId         String?            @db.Uuid
  budget           Decimal            @db.Decimal(10, 2)
  dailyBudget      Decimal?           @db.Decimal(10, 2)
  startDate        DateTime
  endDate          DateTime
  status           CampaignStatus     @default(DRAFT)
  objective        CampaignObjective
  bidStrategy      BidStrategy        @default(LOWEST_COST)
  bidAmount        Decimal?           @db.Decimal(10, 2)
  pacing           CampaignPacing     @default(STANDARD)
  businessCategory BusinessCategory
  websiteUrl       String
  interests        CampaignInterest[]
  audienceCSV      String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  // Relations
  advertiser          Advertiser              @relation(fields: [advertiserId], references: [id])
  client              Client?                 @relation(fields: [clientId], references: [id])
  campaignInventories CampaignInventory[]
  creatives           Creative[]
  statistics          CampaignStatistics[]
  targetingRules      CampaignTargetingRule[]
  bidResponses        BidResponse[]
}

// Campaign inventory relationship
model CampaignInventory {
  campaignId  String   @db.Uuid
  inventoryId String   @db.Uuid
  maxBid      Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  campaign  Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  inventory AdInventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@id([campaignId, inventoryId])
}

// Campaign statistics for reporting
model CampaignStatistics {
  id          String   @id @default(uuid()) @db.Uuid
  campaignId  String   @db.Uuid
  date        DateTime @db.Date
  impressions Int      @default(0)
  clicks      Int      @default(0)
  conversions Int      @default(0)
  spend       Decimal  @default(0) @db.Decimal(10, 2)
  ctr         Float? // Click-through rate
  cpc         Decimal? @db.Decimal(10, 4) // Cost per click

  // Relations
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, date])
}

// Campaign targeting rules
model CampaignTargetingRule {
  id         String            @id @default(uuid()) @db.Uuid
  campaignId String            @db.Uuid
  ruleType   TargetingRuleType
  ruleData   Json
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  // Relations
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model Click {
  id           String   @id @default(uuid()) @db.Uuid
  impressionId String   @db.Uuid
  createdAt    DateTime @default(now())
  // Add other click-related fields as needed
  ipAddress    String?
  userAgent    String?
  referrer     String?

  // Relations
  impression Impression @relation(fields: [impressionId], references: [id])
}

model Client {
  id                String      @id @default(uuid()) @db.Uuid
  name              String
  email             String      @unique
  password          String?
  mobile            String
  companyName       String
  hqLocation        String
  companySize       CompanySize
  registeredAddress String
  companyGSTIN      String
  PAN               String
  CIN               String
  website           String
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  Advertiser        Advertiser? @relation(fields: [advertiserId], references: [id])
  advertiserId      String?     @db.Uuid

  Campaign Campaign[]
}

enum CompanySize {
  ONE_TO_TEN // 1-10
  ELEVEN_TO_FIFTY // 11-50
  FIFTY_ONE_TO_TWO_HUNDRED // 51-200
  TWO_HUNDRED_ONE_TO_FIVE_HUNDRED // 201-500
  FIVE_HUNDRED_ONE_TO_ONE_THOUSAND // 501-1000
  ONE_THOUSAND_AND_ABOVE // 1001+
}

enum InventoryFormat {
  BANNER
  NATIVE
  VIDEO
  INTERSTITIAL
  REWARDED
}

enum InventoryPosition {
  ABOVE_FOLD
  BELOW_FOLD
  SIDEBAR
  FOOTER
  HEADER
  IN_CONTENT
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TargetingRuleType {
  DEMOGRAPHIC
  GEOGRAPHIC
  DEVICE
  CONTEXTUAL
  BEHAVIORAL
  TIME
  FREQUENCY
}

enum PublisherStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

// Campaign enums
enum CampaignStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  DAILY_PAUSED
  PAUSED
  COMPLETED
  CANCELED
  REJECTED
  BUDGET_EXHAUSTED
}

enum CampaignObjective {
  AWARENESS
  CONSIDERATION
  CONVERSION
}

enum CampaignPacing {
  STANDARD
  ACCELERATED
}

enum BusinessCategory {
  AUTOMOTIVE
  BEAUTY
  BUSINESS_SERVICES
  CONSUMER_ELECTRONICS
  EDUCATION
  FINANCE
  FOOD_AND_BEVERAGE
  HEALTH_AND_FITNESS
  HOME_AND_GARDEN
  INSURANCE
  LEGAL_SERVICES
  REAL_ESTATE
  RETAIL
  TECHNOLOGY
  TRAVEL_AND_TOURISM
}

enum CampaignInterest {
  ART_AND_ENTERTAINMENT
  BUSINESS_AND_FINANCE
  FOOD_AND_DRINK
  HEALTH_AND_FITNESS
  HOBBIES_AND_INTERESTS
  HOME_AND_GARDEN
  NEWS_AND_MEDIA
  PERSONAL_CARE_AND_STYLE
  PETS_AND_ANIMALS
  SCIENCE_AND_NATURE
  SPORTS
  TECHNOLOGY
  TRAVEL_AND_LOCAL
}

// Bids strategy enums
enum BidStrategy {
  LOWEST_COST
  COST_CAP
  BID_CAP
  TARGET_COST
}

// Creative enums
enum CreativeType {
  IMAGE
  HTML5
  VIDEO
  HTML
  RICH_MEDIA
}

enum CreativeStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum Language {
  ENGLISH
  HINDI
  SPANISH
  FRENCH
  GERMAN
  CHINESE
  JAPANESE
  ARABIC
  MARATHI
}

enum AuctionLogStatus {
  STARTED
  COMPLETED
  FAILED
  NO_BIDS
}

enum AuctionType {
  FIRST_PRICE
  SECOND_PRICE
}

