model InventoryAvailability {
  id                String               @id @default(uuid()) @db.Uuid
  inventoryId       String               @db.Uuid
  date              DateTime           @db.Date
  totalImpressions  Int
  reservedImpressions Int              @default(0)
  availableImpressions Int
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  // Relations
  inventory         AdInventory        @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@unique([inventoryId, date])
}