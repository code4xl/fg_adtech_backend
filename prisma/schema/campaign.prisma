// Campaign model
model Campaign {
    id               String             @id @default(uuid()) @db.Uuid
    name             String
    advertiserId     String             @db.Uuid
    clientId         String             @db.Uuid
    budget           Decimal            @db.Decimal(10, 2)
    dailyBudget      Decimal?           @db.Decimal(10, 2)
    startDate        DateTime
    endDate          DateTime
    status           CampaignStatus     @default(DRAFT)
    objective        CampaignObjective
    bidStrategy      BidStrategy        @default(LOWEST_COST)
    bidAmount        Decimal?           @db.Decimal(10, 2)
    pacing           CampaignPacing     @default(STANDARD)
    businessCategory BusinessCategory
    websiteUrl       String
    interests        CampaignInterest[]
    ageMin           Int? // Age targeting
    ageMax           Int?
    genders          String[] // Gender targeting
    locations        String[] // Location targeting
    deviceTypes      String[] // Device targeting
    createdAt        DateTime           @default(now())
    updatedAt        DateTime           @updatedAt

    // Relations
    advertiser           Advertiser             @relation(fields: [advertiserId], references: [id]) // for which advertiser
    client               Client?                @relation(fields: [clientId], references: [id]) // for which client
    creatives            Creative[]
    statistics           CampaignStatistics[]
    demographicTargeting DemographicTargeting[]
    geographicTargeting  GeographicTargeting[]
    deviceTargeting      DeviceTargeting[]
    contextualTargeting  ContextualTargeting[]
    behavioralTargeting  BehavioralTargeting[]
    timeTargeting        TimeTargeting[]
    frequencyTargeting   FrequencyTargeting[]
    bidResponses         BidResponse[]

    campaignBudgetTracker CampaignBudgetTracker[]
    hourlyMetrics         HourlyMetrics[]
}

// Campaign statistics for reporting
model CampaignStatistics {
    id          String   @id @default(uuid()) @db.Uuid
    campaignId  String   @db.Uuid
    date        DateTime @db.Date
    impressions Int      @default(0)
    clicks      Int      @default(0)
    conversions Int      @default(0)
    spend       Decimal  @default(0) @db.Decimal(10, 2)
    ctr         Float? // Click-through rate
    cpc         Decimal? @db.Decimal(10, 4) // Cost per click

    // Relations
    campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

    @@unique([campaignId, date])
}

model CampaignBudgetTracker {
    id              String   @id @default(uuid()) @db.Uuid
    campaignId      String   @db.Uuid
    date            DateTime @db.Date
    totalBudget     Decimal  @db.Decimal(10, 2)
    dailyBudget     Decimal  @db.Decimal(10, 2)
    spentToday      Decimal  @default(0) @db.Decimal(10, 2)
    remainingBudget Decimal  @db.Decimal(10, 2)
    isExhausted     Boolean  @default(false)
    lastUpdated     DateTime @default(now())

    // Relations
    campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

    @@unique([campaignId, date])
}
