model Campaign {
  id                      String                    @id @default(uuid()) @db.Uuid
  name                    String
  advertiserId            String                    @db.Uuid
  clientId                String                    @db.Uuid
  startDate               DateTime
  endDate                 DateTime
  status                  CampaignStatus            @default(DRAFT)
  objective               CampaignObjective
  bidStrategy             BidStrategy               @default(LOWEST_COST)
  bidAmount               Decimal?                  @db.Decimal(10, 4)
  pacing                  CampaignPacing            @default(STANDARD)
  businessCategory        BusinessCategory
  websiteUrl              String
  interests               CampaignInterest[]
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  campaignBudgetId        String?                   @db.Uuid
  AdvertiserDailySpending AdvertiserDailySpending[]
  AdvertiserSpending      AdvertiserSpending[]
  behavioralTargeting     BehavioralTargeting[]
  bidResponses            BidResponse[]
  BudgetTransaction       BudgetTransaction[]
  advertiser              Advertiser                @relation(fields: [advertiserId], references: [id])
  campaignBudget          CampaignBudget?           @relation(fields: [campaignBudgetId], references: [id])
  client                  Client                    @relation(fields: [clientId], references: [id])
  dailyBudgets            CampaignDailyBudget[]     @relation("CampaignDailyBudgets")
  CampaignPayment         CampaignPayment?
  statistics              CampaignStatistics[]
  ClickEvent              ClickEvent[]
  contextualTargeting     ContextualTargeting[]
  creatives               Creative[]
  demographicTargeting    DemographicTargeting[]
  deviceTargeting         DeviceTargeting[]
  frequencyTargeting      FrequencyTargeting[]
  geographicTargeting     GeographicTargeting[]
  hourlyMetrics           HourlyMetrics[]
  ImpressionEvent         ImpressionEvent[]
  PublisherRevenue        PublisherRevenue[]
  SystemRevenue           SystemRevenue[]
  timeTargeting           TimeTargeting[]
  ClientCampaign          ClientCampaign[]

  @@index([status, startDate, endDate])
  @@index([status, advertiserId])
  @@index([id, status])
}

model CampaignStatistics {
  id          String   @id @default(uuid()) @db.Uuid
  campaignId  String   @db.Uuid
  date        DateTime @db.Date
  impressions Int      @default(0)
  clicks      Int      @default(0)
  conversions Int      @default(0)
  spend       Decimal  @default(0) @db.Decimal(10, 4)
  ctr         Float?
  cpc         Decimal? @db.Decimal(10, 4)
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, date])
}

model CampaignBudget {
  id          String     @id @default(uuid()) @db.Uuid
  campaignId  String     @unique @db.Uuid
  totalBudget Decimal    @db.Decimal(10, 4)
  spentAmount    Decimal  @default(0) @db.Decimal(10, 4)
  dailyBudget Decimal    @db.Decimal(10, 4)
  isExhausted Boolean    @default(false)
  lastUpdated DateTime   @default(now())
  Campaign    Campaign[]

  @@index([campaignId])
}

model CampaignDailyBudget {
  id             String   @id @default(uuid()) @db.Uuid
  campaignId     String   @db.Uuid
  date           DateTime @db.Date
  spentToday     Decimal  @default(0) @db.Decimal(10, 4)
//   spentAmount    Decimal  @default(0) @db.Decimal(10, 4)
  remainingToday Decimal  @db.Decimal(10, 4)
  isExhausted    Boolean  @default(false)
  lastUpdated    DateTime @default(now())
  campaign       Campaign @relation("CampaignDailyBudgets", fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, date])
  @@index([campaignId, date])
  @@index([date, campaignId])
  @@index([campaignId])
}
