model BidRequest {
  id                String        @id @default(uuid()) @db.Uuid
  inventoryId       String        @db.Uuid
  publisherId       String        @db.Uuid
  requestTimestamp  DateTime      @default(now())
  auctionType       AuctionType   @default(SECOND_PRICE)
  timeout           Int           @default(200)
  websiteId         String        @db.Uuid
  adSlotContext     Json
  externalRequestId String        @unique
  floorPrice        Decimal?      @db.Decimal(10, 4)
  processedAt       DateTime?
  userContext       Json
  auctionLog        AuctionLog?
  inventory         AdInventory   @relation(fields: [inventoryId], references: [id])
  publisher         Publisher     @relation(fields: [publisherId], references: [id])
  website           Website       @relation(fields: [websiteId], references: [id])
  bidResponses      BidResponse[]

  @@index([requestTimestamp])
  @@index([inventoryId, requestTimestamp])
  @@index([publisherId, requestTimestamp])
}
