model Publisher {
  id                     String                   @id @default(uuid()) @db.Uuid
  firstName              String
  lastName               String
  email                  String                   @unique
  emailVerifiedAt        DateTime?
  password               String
  rememberToken          String?
  status                 PublisherStatus          @default(ACTIVE)
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  verificationToken      String?                  @unique
  resetPasswordToken     String?                  @unique
  resetPasswordExpires   DateTime?
  mfaEnabled             Boolean                  @default(false)
  mfaVerificationCode    String?
  mfaCodeExpiry          DateTime?
  paymentThreshold       Decimal                  @default(100.0000) @db.Decimal(10, 4)
  tierId                 String?                  @db.Uuid
  inventories            AdInventory[]
  bidRequests            BidRequest[]
  ClickEvent             ClickEvent[]
  ImpressionEvent        ImpressionEvent[]
  tier                   PublisherTier?           @relation(fields: [tierId], references: [id])
  PublisherBalance       PublisherBalance?
  PublisherDailyRevenue  PublisherDailyRevenue[]
  PublisherPayoutAccount PublisherPayoutAccount[]
  PublisherRevenue       PublisherRevenue[]
  PublisherWithdrawal    PublisherWithdrawal[]
  SystemRevenue          SystemRevenue[]
  websites               Website[]

  @@index([id, status])
  @@index([status])
}

model PublisherTier {
  id             String      @id @default(uuid()) @db.Uuid
  name           String      @unique
  commissionRate Decimal     @default(0.4) @db.Decimal(5, 4)
  createdAt      DateTime    @default(now())
  publishers     Publisher[]
}
