# Add these CDN configuration variables to your .env file

# CDN Configuration
CDN_STORAGE_TYPE=local # local | s3
CDN_STORAGE_PATH=./cdn-files # Local storage path
CDN_BASE_URL=http://localhost:3000/cdn # Base URL for CDN
CDN_API_URL=http://localhost:3000 # API URL for SDK
CDN_SSE_TIMEOUT=250 # SSE timeout in milliseconds
CDN_CACHE_ENABLED=true # Enable Redis caching
CDN_CACHE_TTL=3600 # Cache TTL in seconds (1 hour)

# SDK Build Configuration
SDK_BUILD_PATH=./dist/ocean-ads.min.js # Path to minified SDK

# S3 Configuration (if using S3 storage)
AWS_S3_BUCKET=ocean-ads-cdn # S3 bucket name
AWS_S3_REGION=us-east-1 # AWS region
AWS_S3_ACCESS_KEY=your-access-key # AWS access key
AWS_S3_SECRET_KEY=your-secret-key # AWS secret key

# CloudFront Configuration (optional)
CLOUDFRONT_DISTRIBUTION_ID=your-distribution-id # CloudFront distribution ID
CLOUDFRONT_DOMAIN=https://cdn.oceanads.com # CloudFront domain